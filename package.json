{
  "name": "dsh-chat",
  "displayName": "DSH Chat",
  "description": "Continue-style chat UI for DeepSeek Harness (dsh) inside VS Code. Runs `dsh web` in the background and renders the conversation natively in VS Code (bilingual UI).",
  "version": "0.3.2",
  "publisher": "lin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/NEXTINDIE/dsh-chat.git"
  },
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "agent",
    "chat",
    "continue"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dshChat",
          "title": "%container.title%",
          "icon": "media/icon.svg"
        }
      ],
      "secondarySidebar": [
        {
          "id": "dshChatSecondary",
          "title": "%container.title%",
          "icon": "media/icon.svg",
          "when": "dshChat.supportsSecondarySidebar"
        }
      ]
    },
    "views": {
      "dshChat": [
        {
          "id": "dshChat.view",
          "type": "webview",
          "name": "%view.chat.name%"
        }
      ],
      "dshChatSecondary": [
        {
          "id": "dshChat.viewSecondary",
          "type": "webview",
          "name": "%view.chat.name%"
        }
      ]
    },
    "commands": [
      {
        "command": "dshChat.newSession",
        "title": "%cmd.newSession.title%",
        "icon": "$(add)"
      },
      {
        "command": "dshChat.history",
        "title": "%cmd.history.title%",
        "icon": "$(history)"
      },
      {
        "command": "dshChat.openInEditor",
        "title": "%cmd.openInEditor.title%",
        "icon": "$(open-preview)"
      },
      {
        "command": "dshChat.stop",
        "title": "%cmd.stop.title%",
        "icon": "$(debug-stop)"
      },
      {
        "command": "dshChat.addSelection",
        "title": "%cmd.addSelection.title%"
      },
      {
        "command": "dshChat.addFile",
        "title": "%cmd.addFile.title%"
      },
      {
        "command": "dshChat.startServer",
        "title": "%cmd.startServer.title%"
      },
      {
        "command": "dshChat.restartServer",
        "title": "%cmd.restartServer.title%"
      },
      {
        "command": "dshChat.showLogs",
        "title": "%cmd.showLogs.title%"
      },
      {
        "command": "dshChat.showDiagnostics",
        "title": "%cmd.showDiagnostics.title%"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "dshChat.addSelection",
          "when": "editorHasSelection",
          "group": "dshChat@1"
        }
      ],
      "explorer/context": [
        {
          "command": "dshChat.addFile",
          "when": "!explorerResourceIsFolder",
          "group": "dshChat@1"
        }
      ]
    },
    "configuration": {
      "title": "DSH Chat",
      "properties": {
        "dshChat.url": {
          "type": "string",
          "default": "",
          "markdownDescription": "%config.url%"
        },
        "dshChat.autoStart": {
          "type": "boolean",
          "default": true,
          "description": "%config.autoStart%"
        },
        "dshChat.openPanelOnStartup": {
          "type": "boolean",
          "default": false,
          "description": "%config.openPanelOnStartup%"
        },
        "dshChat.command": {
          "type": "string",
          "default": "dsh",
          "description": "%config.command%"
        },
        "dshChat.startTimeoutSec": {
          "type": "number",
          "default": 90,
          "minimum": 5,
          "maximum": 600,
          "description": "%config.startTimeoutSec%"
        },
        "dshChat.defaultReasoningEffort": {
          "type": "string",
          "default": "",
          "description": "%config.defaultReasoningEffort%"
        },
        "dshChat.showUsageStats": {
          "type": "boolean",
          "default": true,
          "description": "%config.showUsageStats%"
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs --production",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.webview.json",
    "build:scripts": "node esbuild.scripts.mjs",
    "smoke": "npm run build:scripts && node build/smoke.mjs",
    "preview": "node scripts/previewServer.mjs",
    "package": "npm run build && node scripts/package.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/vscode": "^1.101.0",
    "@types/ws": "^8.5.13",
    "@vscode/vsce": "^3.2.1",
    "dompurify": "^3.2.4",
    "esbuild": "^0.24.2",
    "marked": "^15.0.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "ws": "^8.18.0"
  }
}
