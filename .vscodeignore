# 开发期文件不进发布包
src/**
docs/**
scripts/**
test/**
build/**
# README 引用的演示截图必须在包里，否则扩展详情页裂图（其余 docs 仍是开发资料）
!docs/demo.png
# 探针夹具（假 dsh）；`.cjs` 不在下面的 `**/*.ts` 过滤里，会整份进包
shared/**
.vscode/**
.npm-cache/**
.tmp/**
Releases/**
node_modules/**

# 给 AI 会话用的项目约束文档：是仓库的开发者资料，不是扩展的一部分
AGENTS.md

# 开发期日志（曾经被打进包：装完在扩展目录里躺着一个 130B 的 debug.log）
debug.log

# 构建配置本身也不需要
esbuild*.mjs
tsconfig*.json
package-lock.json
.gitignore

# 源码映射
**/*.map
**/*.ts
!dist/**
